# Gateway local/servidor para a NFS-e Nacional
PORT=8787
HOST=127.0.0.1

# restrita = produção restrita/homologação | producao = produção real
NFSE_ENV=restrita
ALLOW_PRODUCTION=false

# Certificado A1/PFX: NUNCA coloque este arquivo dentro do index.html ou localStorage.
NFSE_CERTIFICATE_PATH=/caminho/seguro/certificado.pfx
NFSE_CERTIFICATE_PASSWORD=troque-esta-senha

# Opcional: limita CNPJs que o gateway aceita emitir, separados por vírgula.
NFSE_ALLOWED_CNPJS=

# Opcional no desenvolvimento local. Em servidor compartilhado, configure uma chave forte.
FISCAL_GATEWAY_API_KEY=

# Origens CORS separadas por vírgula. Use * apenas no desenvolvimento local.
FISCAL_ALLOWED_ORIGINS=*

# Diretório onde XMLs autorizados e metadados são armazenados.
FISCAL_STORAGE_DIR=./storage

# SOMENTE TESTES. Nunca ative em produção.
FISCAL_GATEWAY_MOCK=false
