NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/imperio?schema=public

SESSION_TTL_HOURS=12
COOKIE_SECURE=true
CORS_ORIGINS=https://SEU-FRONTEND.example.com

# Cutover seguro: libera escrita somente no Centro na primeira ativação.
OPERATIONAL_WRITES_ENABLED=true
OPERATIONAL_WRITES_UNITS=centro

# Migração de schema, importação e leituras auxiliares permanecem desligadas durante operação normal.
SCHEMA_MIGRATION_ENABLED=false
MIGRATION_IMPORT_ENABLED=false
CLIENT_BATCH_COMMIT_ENABLED=false
SHADOW_READS_ENABLED=false
READ_THROUGH_ENABLED=false
SHADOW_COMPARE_MAX_COLLECTIONS=64

JSON_BODY_LIMIT=20mb
MIGRATION_BATCH_SIZE=500
MIGRATION_TX_TIMEOUT_MS=60000
MIGRATION_PROMOTION_TX_TIMEOUT_MS=180000
MIGRATION_STAGE_RETENTION_DAYS=30
BUSINESS_TIMEZONE=America/Sao_Paulo
MIGRATION_REQUIRE_CANONICAL=true

OPENAPI_ENABLED=false
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_BLOCK_MS=900000
ACTIVATION_TOKEN_TTL_MS=86400000
RESET_TOKEN_TTL_MS=1800000
