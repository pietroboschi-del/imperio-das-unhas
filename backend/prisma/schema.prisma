generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ImportStatus {
  RECEIVED
  VALIDATED
  IMPORTED
  REJECTED
  FAILED
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum SystemRole {
  OWNER
  ADMINISTRATIVE
  OPERATOR
}

enum CredentialTokenPurpose {
  ACTIVATE
  RESET
}

enum MessagingOutboxStatus {
  PENDING
  SENDING
  SENT
  DELIVERED
  READ
  FAILED
  CANCELLED
}

enum MessagingInboundType {
  TEXT
  IMAGE
  DOCUMENT
  UNKNOWN
}

enum MessagingInboundProcessingStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

enum MessagingAutomationStatus {
  PENDING
  READY
  ENQUEUED
  DONE
  FAILED
  CANCELLED
}

enum StockLocationKind {
  CENTRAL
  UNIT
}

model Unit {
  id           String   @id
  name         String
  timezone     String   @default("America/Sao_Paulo")
  active       Boolean  @default(true)
  legacyPayload Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  version      Int      @default(1)
  userAccesses UserUnitAccess[]
  professionals ProfessionalUnit[]
  clients      Client[] @relation("ClientRegistrationUnit")
  clientLinks  ClientUnitLink[]
  bookings     Booking[]
  bookingItems BookingItem[]
  workstations Workstation[]
  stockLocation StockLocation?

  @@index([active])
}

model User {
  id                    String   @id @default(cuid())
  legacyId              String?  @unique
  username              String   @unique
  displayName           String
  passwordHash          String?
  passwordResetRequired Boolean  @default(true)
  active                Boolean  @default(true)
  networkAdmin          Boolean  @default(false)
  systemRole            SystemRole @default(OPERATOR)
  permissions           Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  version               Int      @default(1)
  unitAccesses          UserUnitAccess[]
  sessions              Session[]
  auditEvents           AuditEvent[]
  credentialTokens      UserCredentialToken[]
}

model UserUnitAccess {
  id          String   @id @default(cuid())
  userId      String
  unitId      String
  role        String
  permissions Json?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  unit        Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([userId, unitId])
  @@index([unitId, active])
}

model UserCredentialToken {
  id              String                 @id @default(cuid())
  userId          String
  purpose         CredentialTokenPurpose
  tokenHash       String                 @unique
  expiresAt       DateTime
  usedAt          DateTime?
  invalidatedAt   DateTime?
  createdByUserId String?
  createdAt       DateTime               @default(now())
  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, expiresAt])
}

model LoginRateLimit {
  keyHash         String   @id
  failedAttempts  Int      @default(0)
  windowStartedAt DateTime
  blockedUntil    DateTime?
  updatedAt       DateTime @updatedAt
}

model Session {
  id         String        @id @default(cuid())
  userId     String
  tokenHash  String        @unique
  csrfHash   String
  status     SessionStatus @default(ACTIVE)
  expiresAt  DateTime
  lastSeenAt DateTime      @default(now())
  createdAt  DateTime      @default(now())
  revokedAt  DateTime?
  ipHash     String?
  userAgent  String?
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([expiresAt])
}

model ServiceCategory {
  id            String   @id
  name          String
  description   String?
  sortOrder     Int      @default(0)
  active        Boolean  @default(true)
  legacyPayload Json?
  version       Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  services      Service[]
}

model Workstation {
  id                 String   @id
  unitId             String
  name               String
  allowedCategoryIds Json
  active             Boolean  @default(true)
  legacyPayload      Json?
  version            Int      @default(1)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  unit               Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([unitId, name])
  @@index([unitId, active])
}

model Service {
  id            String           @id
  categoryId    String?
  name          String
  price         Decimal          @db.Decimal(12, 2)
  durationMin   Int
  active        Boolean          @default(true)
  legacyPayload Json?
  version       Int              @default(1)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  category      ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  bookings      Booking[]
  bookingItems  BookingItem[]

  @@index([categoryId, active])
}

model Professional {
  id            String   @id
  name          String
  publicName    String?
  active        Boolean  @default(true)
  legacyPayload Json?
  version       Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  units         ProfessionalUnit[]
  bookings      Booking[]
  bookingItems  BookingItem[]
}

model ProfessionalUnit {
  id             String       @id @default(cuid())
  professionalId String
  unitId         String
  active         Boolean      @default(true)
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  unit           Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([professionalId, unitId])
  @@index([unitId, active])
}

model Client {
  id                 String   @id
  name               String
  active             Boolean  @default(true)
  phone              String?
  email              String?
  registrationUnitId String?
  legacyPayload      Json?
  version            Int      @default(1)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  registrationUnit   Unit?    @relation("ClientRegistrationUnit", fields: [registrationUnitId], references: [id], onDelete: SetNull)
  bookings           Booking[]
  unitLinks          ClientUnitLink[]

  @@index([registrationUnitId])
  @@index([phone])
}


model ClientUnitLink {
  id        String   @id @default(cuid())
  clientId  String
  unitId    String
  source    String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  unit      Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([clientId, unitId])
  @@index([unitId, active])
  @@index([clientId, active])
}

model Booking {
  id            String   @id
  unitId        String
  clientId      String?
  serviceDate   DateTime @db.Date
  startAt       DateTime?
  serviceId     String?
  professionalId String?
  notes         String?
  status        String
  blockAllDay   Boolean  @default(false)
  blockSeriesId String?
  blockRecurrence Json?
  blockException Boolean @default(false)
  legacyPayload Json
  version       Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  unit          Unit     @relation(fields: [unitId], references: [id], onDelete: Restrict)
  client        Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  service       Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  professional  Professional? @relation(fields: [professionalId], references: [id], onDelete: SetNull)
  items         BookingItem[]

  @@index([unitId, serviceDate])
  @@index([unitId, startAt])
  @@index([serviceId])
  @@index([professionalId])
  @@index([clientId, serviceDate])
  @@index([status])
}


model BookingItem {
  id             String   @id
  bookingId      String
  unitId         String
  serviceId      String?
  professionalId String
  startAt        DateTime
  durationMin    Int?
  unitPrice      Decimal? @db.Decimal(14,2)
  preference     Boolean  @default(false)
  forceFit       Boolean  @default(false)
  sortOrder      Int      @default(0)
  clientAreaSnapshot String?
  mustFinishBeforeSameAreaSnapshot Boolean?
  legacyPayload  Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  booking        Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  unit           Unit @relation(fields: [unitId], references: [id], onDelete: Restrict)
  service        Service? @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Restrict)

  @@index([bookingId, sortOrder])
  @@index([unitId, startAt])
  @@index([professionalId, startAt])
}

model WaitlistRequest {
  id            String   @id
  unitId        String
  clientId      String?
  status        String
  legacyPayload Json
  version       Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([unitId, status])
  @@index([clientId])
}

model WaitlistOpportunity {
  id            String   @id
  unitId        String
  requestId     String?
  status        String
  bookingId     String?
  legacyPayload Json
  createdAt     DateTime @default(now())

  @@index([unitId, status])
  @@index([requestId])
  @@index([bookingId])
}

model ManagementTask {
  id             String   @id
  title          String
  dueDate        DateTime? @db.Date
  priority       String   @default("high")
  category       String   @default("general")
  unitId         String
  assignedUserId String
  status         String   @default("OPEN")
  note           String?
  sourceType     String
  sourceId       String
  legacyPayload  Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([sourceType, sourceId, assignedUserId])
  @@index([unitId, status])
  @@index([assignedUserId, status])
}

model AuditEvent {
  id            String   @id
  userId        String?
  unitId        String?
  action        String
  entityType    String?
  entityId      String?
  legacyPayload Json
  occurredAt    DateTime
  createdAt     DateTime @default(now())
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([unitId, occurredAt])
  @@index([entityType, entityId])
  @@index([userId, occurredAt])
}

model MessagingChannel {
  id        String   @id
  provider  String   @default("EVOLUTION")
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  outbox    MessagingOutbox[]
  inbound   MessagingInbound[]

  @@index([enabled])
}

model MessagingOutbox {
  id                String                @id @default(cuid())
  channelId         String
  unitId            String?
  clientId          String?
  bookingId         String?
  commandId         String?
  status            MessagingOutboxStatus @default(PENDING)
  idempotencyKey    String                @unique
  requestHash       String
  messageType       String
  trigger           String
  payload           Json
  attempts          Int                   @default(0)
  lastAttemptAt     DateTime?
  nextAttemptAt     DateTime?
  providerMessageId String?
  lastError         String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @default(now()) @updatedAt
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  cancelledAt       DateTime?
  channel           MessagingChannel      @relation(fields: [channelId], references: [id], onDelete: Restrict)

  @@index([status, nextAttemptAt])
  @@index([channelId, status])
  @@index([unitId, createdAt])
  @@index([clientId, createdAt])
  @@index([bookingId])
  @@index([commandId])
  @@index([channelId, providerMessageId])
  @@unique([channelId, providerMessageId])
}

model MessagingInbound {
  id                     String                            @id @default(cuid())
  provider               String
  channelId              String?
  providerMessageId      String
  providerConversationId String?
  senderPhone            String
  recipientInstance      String
  messageType            MessagingInboundType
  textBody               String?
  mediaMetadata          Json?
  providerTimestamp      DateTime?
  receivedAt             DateTime                          @default(now())
  rawMetadata            Json
  processingStatus       MessagingInboundProcessingStatus @default(RECEIVED)
  unitId                 String?
  clientId               String?
  bookingId              String?
  commandId              String?
  threadRef              String?
  deduplicationKey       String                            @unique
  contentHash            String
  channel                MessagingChannel?                 @relation(fields: [channelId], references: [id], onDelete: Restrict)

  @@index([provider, providerMessageId])
  @@index([channelId, receivedAt])
  @@index([senderPhone, receivedAt])
  @@index([clientId, receivedAt])
  @@index([bookingId])
  @@index([commandId])
  @@index([processingStatus, receivedAt])
}

model MessagingAutomation {
  id             String                    @id @default(cuid())
  unitId         String
  clientId       String?
  bookingId      String?
  sourceType     String
  sourceId       String
  automationType String
  status         MessagingAutomationStatus @default(PENDING)
  scheduledAt    DateTime
  idempotencyKey String                    @unique
  requestHash    String
  logicalKey     String
  generation     Int                       @default(1)
  payload        Json?
  lastError      String?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @default(now()) @updatedAt
  cancelledAt    DateTime?
  doneAt         DateTime?

  @@unique([logicalKey, generation])
  @@index([status, scheduledAt])
  @@index([unitId, status, scheduledAt])
  @@index([bookingId, status])
  @@index([clientId, createdAt])
  @@index([sourceType, sourceId])
  @@index([logicalKey, status])
}

model MigrationEnvelope {
  id                   String       @id @default(cuid())
  instanceId           String
  revision             Int
  schemaVersion        Int
  contractVersion      Int
  dataHash             String
  canonicalDataHash    String?
  sourceKind           String       @default("INSTANCE_EXPORT")
  reconciliationId     String?
  sourceGeneratedAt    DateTime?
  status               ImportStatus @default(RECEIVED)
  summary              Json?
  cutoverManifest      Json?
  cutoverVerification  Json?
  cutoverVerifiedAt    DateTime?
  importedAt           DateTime?
  reconciledAt         DateTime?
  purgeAfter           DateTime?
  errorSummary         Json?
  createdAt            DateTime     @default(now())
  entities             MigrationEntity[]

  @@unique([instanceId, revision])
  @@index([status, createdAt])
}

model MigrationEntity {
  id               String            @id @default(cuid())
  envelopeId       String
  sourceCollection String
  sourceId         String
  unitId           String?
  payloadHash      String
  payload          Json
  createdAt        DateTime          @default(now())
  envelope         MigrationEnvelope @relation(fields: [envelopeId], references: [id], onDelete: Cascade)

  @@unique([envelopeId, sourceCollection, sourceId])
  @@index([sourceCollection, sourceId])
  @@index([unitId])
}



model ClientDuplicateReview {
  id                   String   @id @default(cuid())
  batchId              String
  clusterId            String
  reportHash           String
  decision             String
  mergeTargetClusterId String?
  targetClientId        String?
  note                 String?
  reviewedByUserId     String
  reviewedAt           DateTime @default(now())
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([batchId, clusterId])
  @@index([batchId, decision])
  @@index([reviewedByUserId, reviewedAt])
}

model OpenCommand {
  id                  String   @id
  unitId              String
  clientId            String?
  serviceDate         DateTime @db.Date
  status              String
  grossAmount         Decimal  @db.Decimal(14,2)
  discountAmount      Decimal  @db.Decimal(14,2)
  appliedSignalAmount Decimal  @db.Decimal(14,2)
  appliedCreditAmount Decimal  @db.Decimal(14,2)
  customerFeeAmount   Decimal  @db.Decimal(14,2)
  remainingAmount     Decimal  @db.Decimal(14,2)
  legacyPayload       Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  version             Int      @default(1)
  payments            CommandPayment[]
  items               CommandServiceItem[]

  @@index([unitId, serviceDate])
  @@index([clientId])
}

model CashSession {
  id            String   @id
  unitId        String
  businessDate  DateTime @db.Date
  status        String
  openingAmount Decimal  @db.Decimal(14,2)
  closingAmount Decimal? @db.Decimal(14,2)
  openedByUserId String
  closedByUserId String?
  openedAt      DateTime @default(now())
  closedAt      DateTime?
  version       Int      @default(1)
  legacyPayload Json?
  payments      CommandPayment[]

  @@index([unitId, businessDate, status])
}

model CommandPayment {
  id            String   @id
  commandId     String
  cashSessionId String?
  unitId        String
  method        String
  amount        Decimal  @db.Decimal(14,2)
  status        String   @default("CONFIRMED")
  receivedByUserId String
  receivedAt    DateTime @default(now())
  legacyPayload Json?
  command       OpenCommand @relation(fields: [commandId], references: [id], onDelete: Restrict)
  cashSession   CashSession? @relation(fields: [cashSessionId], references: [id], onDelete: Restrict)

  @@index([unitId, receivedAt])
  @@index([commandId, status])
  @@index([cashSessionId])
}

model ClientCreditOpening {
  id        String   @id
  clientId  String
  amount    Decimal  @db.Decimal(14,2)
  currency  String   @default("BRL")
  source    String
  createdAt DateTime @default(now())

  @@index([clientId])
}

model ClientPackageOpening {
  id             String   @id
  clientId       String
  name           String
  remainingUnits Decimal  @db.Decimal(14,4)
  totalUnits     Decimal  @db.Decimal(14,4)
  expiresAt      DateTime? @db.Date
  status         String
  legacyPayload  Json?
  createdAt      DateTime @default(now())

  @@index([clientId, status])
}

model ReceivableOpening {
  id             String   @id
  clientId       String?
  unitId         String?
  sourceDate     DateTime? @db.Date
  dueDate        DateTime? @db.Date
  originalAmount Decimal  @db.Decimal(14,2)
  balance        Decimal  @db.Decimal(14,2)
  status         String
  legacyPayload  Json?
  createdAt      DateTime @default(now())

  @@index([unitId, status])
  @@index([clientId, status])
}

model StockBalanceOpening {
  id            String   @id
  productId     String
  locationId    String
  qty           Decimal  @db.Decimal(18,4)
  avgCost       Decimal  @db.Decimal(14,4)
  legacyPayload Json?
  createdAt     DateTime @default(now())

  @@unique([productId, locationId])
  @@index([locationId])
}

model Product {
  id            String   @id
  sku           String?  @unique
  name          String
  type          String
  groupName     String?
  familyId      String?
  brand         String?
  unit          String   @default("un")
  packageQty    Decimal? @db.Decimal(18,4)
  baseUnit      String?
  defaultCost   Decimal  @default(0) @db.Decimal(14,4)
  salePrice     Decimal  @default(0) @db.Decimal(14,2)
  minStock      Decimal  @default(0) @db.Decimal(18,4)
  supplier      String?
  allocations   Json?
  active        Boolean  @default(true)
  version       Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  balances      StockBalance[]
  movements     StockMovement[]
  purchaseItems StockPurchaseItem[]
  transferItems StockTransferItem[]

  @@index([active, type])
  @@index([familyId])
}

model StockLocation {
  id                   String            @id
  kind                 StockLocationKind
  unitId               String?           @unique
  name                 String
  active               Boolean           @default(true)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  unit                 Unit?             @relation(fields: [unitId], references: [id], onDelete: Restrict)
  balances             StockBalance[]
  movementEntries      StockMovement[]   @relation("StockMovementLocation")
  sourceMovements      StockMovement[]   @relation("StockMovementSource")
  destinationMovements StockMovement[]   @relation("StockMovementDestination")
  purchases            StockPurchase[]
  sourceTransfers      StockTransfer[]   @relation("StockTransferSource")
  destinationTransfers StockTransfer[]   @relation("StockTransferDestination")

  @@index([kind, active])
}

model StockBalance {
  id         String   @id @default(cuid())
  productId  String
  locationId String
  qty        Decimal  @default(0) @db.Decimal(18,4)
  avgCost    Decimal  @default(0) @db.Decimal(14,4)
  version    Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  product    Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  location   StockLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@unique([productId, locationId])
  @@index([locationId])
}

model StockMovement {
  id                    String   @id @default(cuid())
  type                  String
  productId             String
  locationId            String
  sourceLocationId      String?
  destinationLocationId String?
  quantity              Decimal  @db.Decimal(18,4)
  unitCost              Decimal  @db.Decimal(14,4)
  beforeQty             Decimal  @db.Decimal(18,4)
  afterQty              Decimal  @db.Decimal(18,4)
  performedByUserId     String
  referenceType         String
  referenceId           String
  operationKey          String   @unique
  reason                String?
  createdAt             DateTime @default(now())
  product               Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  location              StockLocation @relation("StockMovementLocation", fields: [locationId], references: [id], onDelete: Restrict)
  sourceLocation        StockLocation? @relation("StockMovementSource", fields: [sourceLocationId], references: [id], onDelete: Restrict)
  destinationLocation   StockLocation? @relation("StockMovementDestination", fields: [destinationLocationId], references: [id], onDelete: Restrict)

  @@index([locationId, createdAt])
  @@index([productId, createdAt])
  @@index([referenceType, referenceId])
}

model StockPurchase {
  id                    String   @id @default(cuid())
  destinationLocationId String
  purchaseDate          DateTime @db.Date
  supplier              String
  freight               Decimal  @default(0) @db.Decimal(14,2)
  goodsTotal            Decimal  @db.Decimal(14,2)
  total                 Decimal  @db.Decimal(14,2)
  status                String   @default("RECEIVED")
  note                  String?
  createdByUserId       String
  idempotencyKey        String   @unique
  createdAt             DateTime @default(now())
  destinationLocation   StockLocation @relation(fields: [destinationLocationId], references: [id], onDelete: Restrict)
  items                 StockPurchaseItem[]

  @@index([destinationLocationId, purchaseDate])
}

model StockPurchaseItem {
  id             String   @id @default(cuid())
  purchaseId     String
  productId      String
  qty            Decimal  @db.Decimal(18,4)
  unitCost       Decimal  @db.Decimal(14,4)
  freightShare   Decimal  @db.Decimal(14,4)
  landedUnitCost Decimal  @db.Decimal(14,4)
  sortOrder      Int      @default(0)
  purchase       StockPurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product        Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([purchaseId, sortOrder])
  @@index([productId])
}

model StockTransfer {
  id                    String   @id @default(cuid())
  sourceLocationId      String
  destinationLocationId String
  transferDate          DateTime @db.Date
  status                String   @default("SEPARATED")
  note                  String?
  createdByUserId       String
  sentByUserId          String?
  receivedByUserId      String?
  sentAt                DateTime?
  receivedAt            DateTime?
  idempotencyKey        String   @unique
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  sourceLocation        StockLocation @relation("StockTransferSource", fields: [sourceLocationId], references: [id], onDelete: Restrict)
  destinationLocation   StockLocation @relation("StockTransferDestination", fields: [destinationLocationId], references: [id], onDelete: Restrict)
  items                 StockTransferItem[]

  @@index([sourceLocationId, status])
  @@index([destinationLocationId, status])
}

model StockTransferItem {
  id         String   @id @default(cuid())
  transferId String
  productId  String
  qty        Decimal  @db.Decimal(18,4)
  unitCost   Decimal? @db.Decimal(14,4)
  sortOrder  Int      @default(0)
  transfer   StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product    Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([transferId, sortOrder])
  @@index([productId])
}

model ProfessionalPayableOpening {
  id             String   @id
  kind           String
  professionalId String
  unitId         String?
  amount         Decimal  @db.Decimal(14,2)
  sourceId       String?
  legacyPayload  Json?
  createdAt      DateTime @default(now())

  @@index([unitId, kind])
  @@index([professionalId, kind])
}

model FiscalPendingDocument {
  id                String   @id
  unitId            String
  commandId         String?
  clientId          String?
  documentType      String?
  status            String
  amount            Decimal  @db.Decimal(14,2)
  referenceDate     DateTime? @db.Date
  transmissionState String?
  legacyPayload     Json?
  createdAt         DateTime @default(now())

  @@index([unitId, status])
  @@index([clientId])
}


model CommandServiceItem {
  id                    String   @id
  commandId             String
  unitId                 String
  serviceId              String
  professionalId         String
  quantity               Decimal  @default(1) @db.Decimal(14,4)
  unitPrice              Decimal  @db.Decimal(14,2)
  discountAmount         Decimal  @default(0) @db.Decimal(14,2)
  netServiceAmount       Decimal  @db.Decimal(14,2)
  commissionPercent      Decimal? @db.Decimal(7,4)
  commissionFixedAmount  Decimal? @db.Decimal(14,2)
  commissionAmount       Decimal  @default(0) @db.Decimal(14,2)
  createdAt              DateTime @default(now())
  command                OpenCommand @relation(fields: [commandId], references: [id], onDelete: Restrict)

  @@index([commandId])
  @@index([unitId, professionalId])
  @@index([serviceId])
}


model ProfessionalObligation {
  id             String   @id
  professionalId String
  unitId         String
  commandId      String?
  commandItemId  String?
  kind           String
  competenceDate DateTime @db.Date
  amount         Decimal  @db.Decimal(14,2)
  paidAmount     Decimal  @default(0) @db.Decimal(14,2)
  status         String   @default("OPEN")
  legacyPayload  Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([commandItemId, kind])
  @@index([professionalId, unitId, competenceDate])
  @@index([unitId, status])
}

model ProfessionalSettlement {
  id             String   @id
  professionalId String
  unitId         String
  amount         Decimal  @db.Decimal(14,2)
  paidAt         DateTime
  paidByUserId   String
  legacyPayload  Json?
  createdAt      DateTime @default(now())

  @@index([professionalId, unitId, paidAt])
}
