    "test:wa1": "node test/wa1-messaging-foundation.contract.mjs && node test/wa1-messaging-foundation.integration.mjs",
    "test:wa2": "node test/wa2-evolution-messaging.contract.mjs && node test/wa2-evolution-messaging.integration.mjs",
    "test:wa2.1": "node test/wa2.1-sending-recovery.integration.mjs",
    "test:wa3a": "node test/wa3a-booking-availability.integration.mjs",
    "test:wa3b": "node test/wa3b-agent-booking.integration.mjs",
    "test:wa3c1": "node test/wa3c1-multi-availability.integration.mjs",
    "test:wa3c2": "node test/wa3c2-agent-multi-availability.integration.mjs",
    "test:wa3c3": "node test/wa3c3-agent-multi-booking.integration.mjs",
    "test:wa3c4": "node test/wa3c4-parity.contract.mjs",
    "test:wa4.1": "node test/wa4.1-waitlist-audit.contract.mjs",
    "test:wa4.2": "node test/wa4.2-agent-waitlist.integration.mjs",
    "test:wa4.3": "node test/wa4.3-reception-notification.integration.mjs",
    "test:wa4.4": "node test/wa4.4-opportunity-match.integration.mjs && node test/wa4.4-booking-trigger.contract.mjs",
    "test:wa4.5": "node test/wa4.5-offer-candidate.integration.mjs",
    "test:wa4.6": "node test/wa4.6-trace-state.integration.mjs && node test/wa4.6-state-security.contract.mjs",
