{
  "name": "imperio-backend-v98b",
  "version": "0.98.1",
  "private": true,
  "description": "V98b — segurança, autorização deny-by-default, ativação de credenciais e contrato HTTP do Império das Unhas.",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "admin:create": "tsx scripts/create-admin.ts",
    "import:validate": "tsx scripts/validate-envelope.ts",
    "import:envelope": "tsx scripts/import-envelope.ts",
    "test:contract": "node test/v95-contract.test.mjs",
    "test:shadow": "node test/v96-shadow-contract.test.mjs",
    "test:readthrough": "node test/v97-read-through-contract.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:contracts": "node test/v95-contract.test.mjs && node test/v96-shadow-contract.test.mjs && node test/v97-read-through-contract.test.mjs",
    "test:reconciliation": "node test/v98a-reconciliation.test.mjs",
    "test:integration": "node test/v98a-postgres.integration.mjs",
    "test:import-contract": "node test/v98a-import-integrity.contract.mjs",
    "cutover:project": "node tools/project-cutover-state.mjs",
    "test:cutover": "node test/v98a-cutover-projection.test.mjs",
    "test:cutover-normalization": "node test/v98a-cutover-normalization.contract.mjs",
    "test:money": "node test/v98a-decimal-money.test.mjs",
    "test": "npm run test:contracts && npm run test:reconciliation && npm run test:import-contract && npm run test:cutover && npm run test:cutover-normalization && npm run test:money && npm run test:v98b",
    "ci": "npm run prisma:generate && npm run prisma:migrate && npm run build && npm test && npm run test:integration && npm run test:security-integration",
    "reconcile:exports": "node tools/reconcile-exports.mjs",
    "test:v98b": "node --experimental-strip-types test/v98b-security-contract.test.mjs && node --experimental-strip-types test/v98b-permission-policy.test.mjs && node --experimental-strip-types test/v98b-legacy-permissions.test.mjs && node --experimental-strip-types test/v98b-three-units.test.mjs",
    "test:security-integration": "node test/v98b-security.integration.mjs",
    "test:characterization": "node ../tests_characterization/run-characterization-gate.mjs",
    "test:professional-obligations": "python3 test/v98a-professional-obligation-parity.test.py",
    "test:operational-writes": "node test/v99-operational-writes.integration.mjs",
    "test:finance-flow": "node test/v99-finance-flow.integration.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@prisma/client": "^6.0.0",
    "argon2": "^0.41.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "helmet": "^8.0.0",
    "prisma": "^6.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "@nestjs/swagger": "11.4.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
